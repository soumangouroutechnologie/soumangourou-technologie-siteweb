generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  name          String
  role          Role       @default(ADMIN)
  avatar        String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  posts         BlogPost[]

  @@map("users")
}

model ProjectCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  projects    Project[]

  @@map("project_categories")
}

model Project {
  id            String          @id @default(uuid())
  title         String
  slug          String          @unique
  summary       String
  description   String          @db.Text
  coverImage    String
  images        String[]
  liveUrl       String?
  githubUrl     String?
  technologies  String[]
  isFeatured    Boolean         @default(false)
  order         Int             @default(0)
  categoryId    String?
  category      ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("projects")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  posts       BlogPost[]

  @@map("categories")
}

model Tag {
  id        String          @id @default(uuid())
  name      String          @unique
  slug      String          @unique
  posts     PostTag[]

  @@map("tags")
}

model BlogPost {
  id             String      @id @default(uuid())
  title          String
  slug           String      @unique
  excerpt        String      @db.Text
  content        String      @db.Text
  featuredImage  String
  galleryImages  String[]
  status         PostStatus  @default(PUBLISHED)
  publishedAt    DateTime?   @default(now())
  readingTime    Int         @default(5)
  authorId       String?
  author         User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName     String?     @default("Équipe Soumangourou")
  authorAvatar   String?
  categoryId     String?
  category       Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  allowComments  Boolean     @default(true)
  seoTitle       String?
  seoDescription String?     @db.Text
  views          Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tags           PostTag[]
  comments       Comment[]

  @@map("blog_posts")
}

model PostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  name      String
  email     String
  content   String   @db.Text
  isApproved Boolean @default(true)
  createdAt DateTime @default(now())

  @@map("comments")
}

model Testimonial {
  id         String   @id @default(uuid())
  clientName String
  role       String
  company    String
  avatar     String?
  quote      String   @db.Text
  rating     Int      @default(5)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("testimonials")
}

model Service {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  icon        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("services")
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("faq")
}

model Gallery {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  category    String         @default("Général")
  description String?
  images      GalleryImage[]
  createdAt   DateTime       @default(now())

  @@map("galleries")
}

model GalleryImage {
  id        String   @id @default(uuid())
  galleryId String
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  imageUrl  String
  title     String?
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("gallery_images")
}

model YoutubeVideo {
  id          String   @id @default(uuid())
  title       String
  youtubeId   String
  description String?
  isPlaylist  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("youtube_videos")
}

model YoutubePlaylist {
  id          String   @id @default(uuid())
  title       String
  playlistId  String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("youtube_playlists")
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String   @unique // Facebook, LinkedIn, Instagram, TikTok, YouTube, GitHub
  url       String
  icon      String
  isActive  Boolean  @default(true)
  order     Int      @default(0)

  @@map("social_links")
}

model ContactMessage {
  id        String   @id @default(uuid())
  fullName  String
  company   String?
  phone     String?
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contacts")
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  isActive     Boolean  @default(true)

  @@map("newsletters")
}

model Media {
  id        String   @id @default(uuid())
  filename  String
  url       String
  publicId  String?
  format    String?
  size      Int?
  createdAt DateTime @default(now())

  @@map("media")
}

model Settings {
  id             String   @id @default("default")
  // Hero Section
  heroTitle      String   @default("SOUMANGOUROU TECHNOLOGIE")
  heroSubtitle   String   @default("Nous concevons des solutions digitales modernes pour accompagner les entreprises africaines vers l'excellence.")
  heroVideoUrl   String   @default("/videos/hero.mp4")
  heroCtaText    String   @default("DÉCOUVRIR NOS PROJETS")
  heroCtaLink    String   @default("#projets")

  // About Section
  aboutBadge     String   @default("À PROPOS DE NOUS →")
  aboutTitle     String   @default("L'innovation au service du développement africain")
  aboutMainText  String   @default("SOUMANGOUROU TECHNOLOGIE est une entreprise ivoirienne spécialisée dans la conception de solutions numériques modernes et accessibles.")
  aboutSubText   String   @default("Notre mission est d'accompagner les entreprises, associations et entrepreneurs grâce à des outils performants, tout en valorisant notre identité et nos valeurs africaines.")
  aboutImageUrl  String   @default("/images/about-african-king.png")
  aboutBadgeStat String   @default("100%")
  aboutBadgeLabel String  @default("Excellence | Savoir-faire Africain")

  // About 4 Values
  aboutValue1Title String @default("Écoute & Conseil")
  aboutValue1Desc  String @default("Nous comprenons vos besoins pour vous proposer les meilleures solutions.")
  aboutValue2Title String @default("Qualité & Performance")
  aboutValue2Desc  String @default("Nous développons des produits fiables, sécurisés et évolutifs.")
  aboutValue3Title String @default("Innovation")
  aboutValue3Desc  String @default("Nous intégrons les dernières technologies pour vous garder en avance.")
  aboutValue4Title String @default("Engagement Africain")
  aboutValue4Desc  String @default("Nous valorisons notre culture et contribuons à l'essor du numérique en Afrique.")

  // Contact & Address
  companyEmail   String   @default("contact@soumangourou.tech")
  companyPhone   String   @default("+225 07 08 09 10 11")
  companyAddress String   @default("Abidjan, Côte d'Ivoire")
  mapEmbedUrl    String?  @default("https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d127108.64724773802!2d-4.049449830578613!3d5.348443905470125!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xfb8e34927f8a7e5%3A0x6b772413158f4a3e!2sAbidjan%2C%20C%C3%B4te%20d'Ivoire!5e0!3m2!1sfr!2sfr!4v1700000000000!5m2!1sfr!2sfr")

  // Footer & General
  footerTagline  String   @default("Concepteur de solutions digitales d'excellence inspirées de l'héritage africain.")
  copyrightText  String   @default("© 2026 SOUMANGOUROU TECHNOLOGIE. Tous droits réservés.")

  // Colors & Theme
  primaryColor   String   @default("#D4AF37")
  darkBgColor    String   @default("#0B0B0C")
  beigeBgColor   String   @default("#F7F5F0")

  // Menu Items (JSON string or object)
  menuItems      Json?

  updatedAt      DateTime @updatedAt

  @@map("settings")
}

model SeoSettings {
  id             String   @id @default("default")
  siteTitle      String   @default("SOUMANGOUROU TECHNOLOGIE | Digital Agency & Heritage")
  siteDescription String  @default("Solutions numériques modernes inspirées par l'héritage africain.")
  ogImage        String?
  keywords       String[]
  twitterHandle  String?  @default("@soumangourou_tech")
  updatedAt      DateTime @updatedAt

  @@map("seo_settings")
}
