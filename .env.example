# ====================================================================
# VARIABLES D'ENVIRONNEMENT - SOUMANGOUROU TECHNOLOGIE
# ====================================================================

# Base de données PostgreSQL (Supabase ou PostgreSQL standard)
# DATABASE_URL : Connexion poolée (port 6543 sur Supabase)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL : Connexion directe (port 5432 sur Supabase, requise pour les migrations Prisma)
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentification Administration (CMS)
# Clé secrète JWT d'au moins 32 caractères pour signer les sessions admin
JWT_SECRET="remplacer_par_un_secret_jwt_aleatoire_et_securise_d_au_moins_32_caracteres"

# Supabase Storage & Client
NEXT_PUBLIC_SUPABASE_URL="https://[VOTRE_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# URL publique de production du site
NEXT_PUBLIC_SITE_URL="https://soumangouroutechnologie.com"

